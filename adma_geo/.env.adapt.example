# Credentials for the ADAPT SMB share, used by docker-compose.adapt.yml.
# Copy the values into .env next to the compose file. Never commit the real ones.
#
# The account needs read access to the share and nothing more. A machine account
# will not work.

ADAPT_HOST=snr18
ADAPT_SHARE=Adapt
ADAPT_USER=
ADAPT_PASS=
ADAPT_DOMAIN=

# Drop to 2.1 if the mount fails to negotiate 3.0.
ADAPT_SMB_VERSION=3.0

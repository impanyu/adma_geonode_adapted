# Production Environment Variables
# Copy this file to .env (in adma_geo/ directory, alongside docker-compose-adma.yml)
# and replace every value below.

# ============================================================================
# REQUIRED — docker-compose will refuse to start without these.
# ============================================================================

# Django settings
# DEBUG should always be False in production. Setting it to True exposes the
# Django debug page (full stack traces, source code, all settings).
DEBUG=False

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Rotating this invalidates all sessions and password-reset tokens.
SECRET_KEY=GENERATE_ME

# Database password used by the db container AND the django/celery containers
# to connect. All three must use the same value. If the postgres data volume
# already exists with the old password, either keep that password or run
# ALTER USER adma_geo WITH PASSWORD '<new>'; before changing this.
POSTGRES_PASSWORD=GENERATE_ME

# GeoServer admin password used by the geoserver container AND django (for the
# REST client). Must match what's actually configured inside GeoServer.
GEOSERVER_ADMIN_PASSWORD=GENERATE_ME

# Database connection (rarely changed)
POSTGRES_DB=adma_geo
POSTGRES_USER=adma_geo

# ============================================================================
# Third-party API credentials — set whichever ones the deployment uses.
# ============================================================================
OPENAI_API_KEY=
REALM5_API_KEY=
JD_CLIENT_ID=
JD_CLIENT_SECRET=
JD_REFRESH_TOKEN=
JD_ORG_ID=

# ============================================================================
# Public URLs / hosts
# ============================================================================
ADMA_PUBLIC_URL=https://adma.example.com
ALLOWED_HOSTS=adma.example.com,localhost

# John Deere webhook (Data Subscription Service)
JD_WEBHOOK_CALLBACK_URL=https://adma.example.com/api/v1/webhooks/johndeere/
JD_WEBHOOK_USERNAME=  # random; used by JD to authenticate its POSTs to us
JD_WEBHOOK_PASSWORD=  # random; generate e.g. `python -c 'import secrets; print(secrets.token_urlsafe(32))'`

# Environment Configuration Template
# Copy this file to .env and fill in the values
# .env files are ignored by git for security

# Realm5 API Configuration
REALM5_API_KEY=your_realm5_api_key_here

# Django Configuration (optional overrides)
# SECRET_KEY=your-django-secret-key
# DEBUG=True

# Database Configuration (optional overrides)
# POSTGRES_DB=adma_geo
# POSTGRES_USER=adma_geo
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# GeoServer Configuration (optional overrides)
# GEOSERVER_URL=http://geoserver:8080/geoserver
# GEOSERVER_ADMIN_USER=admin
# GEOSERVER_ADMIN_PASSWORD=your-geoserver-password

# John Deere API
# Sandbox by default. Switch to https://partnerapi.deere.com/platform once the
# application has been granted production access on developer.deere.com.
JD_API_BASE_URL=https://sandboxapi.deere.com/platform
JD_CLIENT_ID=
JD_CLIENT_SECRET=
JD_REFRESH_TOKEN=
JD_ORG_ID=
# Where John Deere POSTs events, and the Basic credentials it must present.
JD_WEBHOOK_CALLBACK_URL=https://your-host/api/v1/webhooks/johndeere/
JD_WEBHOOK_USERNAME=
JD_WEBHOOK_PASSWORD=
